// Kredensial WiFi
#define WIFI_SSID     "NAMA_WIFI_ANDA"
#define WIFI_PASSWORD "PASSWORD_WIFI_ANDA"

// ════════════════════════════════════════════════════════════════════════════
// OPSI 1: Google Apps Script (default - gunakan ini jika STORAGE_MODE = "GAS")
// ════════════════════════════════════════════════════════════════════════════
// Google Apps Script Web App URL (Deploy > Web App > URL)
#define GOOGLE_SCRIPT_URL "https://script.google.com/macros/s/SCRIPT_ID_ANDA/exec"

// ════════════════════════════════════════════════════════════════════════════
// OPSI 2: Firebase Realtime Database (gunakan ini jika STORAGE_MODE = "FIREBASE")
// ════════════════════════════════════════════════════════════════════════════
// 
// Langkah-langkah mendapatkan kredensial Firebase:
// 1. Buka Firebase Console: https://console.firebase.google.com/
// 2. Buat project baru atau pilih yang sudah ada
// 3. Di halaman Project Settings > Service Accounts:
//    - Copy "API Key" dari bagian "Web API Key"
// 4. Di halaman Realtime Database:
//    - Copy URL database Anda (format: https://NAMA_PROJECT.firebaseio.com)
// 5. Di halaman Authentication > Users:
//    - Buat user baru dengan email dan password
//    - Atau aktifkan "Anonymous Authentication"
//
// Catatan: Untuk mode production, lebih baik menggunakan authentication dengan
// email/password atau token dari Firebase Service Account.

#define FIREBASE_API_KEY       "YOUR_FIREBASE_API_KEY_HERE"
#define FIREBASE_DATABASE_URL  "https://YOUR_PROJECT_NAME.firebaseio.com"
#define FIREBASE_USER_EMAIL    "YOUR_FIREBASE_EMAIL@example.com"
#define FIREBASE_USER_PASSWORD "YOUR_FIREBASE_PASSWORD"
